# Copy relevant values into your root .env
# for deployment behind Nginx reverse proxy.
# For Coolify app-container Nginx -> host app, use 0.0.0.0 so gateway can connect.

SERVER_HOST=0.0.0.0
SERVER_PORT=9988
SERVER_BEHIND_PROXY=true
SERVER_PROXY_REAL_API_HEADER=X-Forwarded-For
STORAGE_PATH=./storage
